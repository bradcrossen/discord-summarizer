# Copy to .env for local runs and docker compose. Never commit the real one.

# Required
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# From `claude setup-token`. Optional on a dev box where `claude` is signed in.
CLAUDE_CODE_OAUTH_TOKEN=

# Local runs only: keep state out of C:\config
CONFIG_DIR=./config

# Optional (defaults shown)
# ERROR_WEBHOOK_URL=
# SUMMARY_TIME=20:00
# SUMMARY_TZ=America/Los_Angeles
# SUMMARY_MODEL=claude-sonnet-5
# SUMMARY_TIMEOUT=300
# MIN_MESSAGES=5
# INCLUDE_BOTS=0
# CATCHUP_HOURS=3
# MAX_TRANSCRIPT_CHARS=400000
